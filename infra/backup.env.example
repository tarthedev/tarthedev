# Settings for infra/scripts/backup-db.sh and restore-db.sh
# (docs/runbooks/backup-restore.md).
#
# Copy to /opt/dwrg/backup.env and chmod 600. Kept apart from app.env so the
# API and worker containers never see the backup keys.
# Format: KEY=value, one per line, no comments after a value.

# --- Off-site storage: Backblaze B2 ---------------------------------------------
# An rclone remote named "offsite", configured by RCLONE_CONFIG_OFFSITE_*
# variables (https://rclone.org/b2/). Use a B2 application key limited to the
# backup bucket WITHOUT the deleteFiles capability: then the droplet can add
# backups but never delete or overwrite them, even if it is broken into. Old
# backups are removed by the bucket's lifecycle rule instead.
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=B2_KEY_ID
RCLONE_CONFIG_OFFSITE_KEY=B2_APPLICATION_KEY
# Hide instead of delete, so rclone never needs delete rights.
RCLONE_CONFIG_OFFSITE_HARD_DELETE=false
#
# Another S3-compatible store works the same way, for example:
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Wasabi
# RCLONE_CONFIG_OFFSITE_ENDPOINT=s3.us-east-1.wasabisys.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# Where the dumps go: <remote>:<bucket>[/<folder>]. Each lands at
# <BACKUP_DEST>/<env>/<year>/<month>/dwrg-<env>-<UTC time>.dump.age
BACKUP_DEST=offsite:dwrg-db-backups

# --- Encryption: age -------------------------------------------------------------
# The PUBLIC key (age1...). Backups are encrypted to it before they leave the
# droplet. The private key that decrypts them is kept OFF the droplet (the
# owners' password manager plus a printed copy); restores need it.
BACKUP_AGE_RECIPIENT=age1replacewiththepublickeyfromagekeygen

# --- Alert when a night is missed ----------------------------------------------
# Optional but recommended: a heartbeat ("cron job") check URL from the uptime
# service (healthchecks.io, Better Stack...). Pinged after every good backup;
# <url>/fail is pinged when a backup fails. The service alerts when a ping is
# late or failed.
BACKUP_HEARTBEAT_URL=

# --- pg_dump ------------------------------------------------------------------------
# The postgres image that runs pg_dump and pg_restore. Its major version must
# be at least the server's (17 in production).
BACKUP_PG_IMAGE=postgres:17
