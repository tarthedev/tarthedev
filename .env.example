# ---------------------------------------------------------------------------
# KPI Command Center — environment
#
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -base64 48      # SESSION_SECRET
#   openssl rand -base64 24      # POSTGRES_PASSWORD
# ---------------------------------------------------------------------------

# --- database --------------------------------------------------------------
# With docker compose, the app builds this from the POSTGRES_* values below and
# this line is ignored. Set it directly only when running against an external
# Postgres.
DATABASE_URL="postgresql://kpi:CHANGE_ME@127.0.0.1:5432/kpi?schema=public"

POSTGRES_USER=kpi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kpi
# Host port for Postgres. Bound to 127.0.0.1 only; change if 5433 is taken.
POSTGRES_PORT=5433

# --- application -----------------------------------------------------------
# Loopback port the reverse proxy forwards to. Change if 3020 is already used.
APP_PORT=3020
# Public URL. Must be https:// in production — the session cookie's Secure flag
# is set from this value.
APP_URL="https://kpi.example.com"
# Signs the session cookie. At least 32 characters. Rotating it signs everyone out.
SESSION_SECRET="CHANGE_ME_openssl_rand_base64_48"
SESSION_TTL_DAYS=30
# IANA timezone. Period boundaries and "today" are resolved in this zone.
TIMEZONE="America/New_York"
# Set false after creating your account to close signup.
ALLOW_REGISTRATION=true

# --- AI --------------------------------------------------------------------
# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=""
AI_ENABLED=true
# true runs the deterministic mock provider: the whole pipeline works with no
# network calls and no spend. Ideal for development and for trying the UI.
AI_DEV_MODE=false

# Model routing. Cheap tier handles everything routine; the escalation and
# deep-analysis tiers are reserved for work that has earned the cost.
# These are plain strings so a new model needs no redeploy.
AI_EXTRACTION_MODEL="claude-sonnet-5"
AI_COACH_MODEL="claude-sonnet-5"
AI_CHAT_MODEL="claude-sonnet-5"
AI_ESCALATION_MODEL="claude-opus-5"
AI_DEEP_ANALYSIS_MODEL="claude-opus-5"

# Soft monthly cap in USD. Optional AI stops here; screenshot extraction
# continues to 1.25x this figure and then stops too. 0 disables the limit.
AI_MONTHLY_BUDGET_USD=10
# Readings below this confidence are held for review instead of counting.
AI_CONFIDENCE_THRESHOLD=0.8
# Rungs in the extraction retry ladder (1-3).
AI_MAX_EXTRACTION_ATTEMPTS=3
# Optional JSON overriding the built-in price table, USD per million tokens,
# for when Anthropic changes rates:
# AI_PRICE_OVERRIDES='{"claude-sonnet-5":{"input":3,"output":15}}'

# --- storage ---------------------------------------------------------------
# local writes to STORAGE_PATH; s3 targets any S3-compatible bucket (R2, B2, S3).
STORAGE_DRIVER=local
# Must be outside the web root. Under docker compose this is a named volume.
STORAGE_PATH="./storage"

# Only needed when STORAGE_DRIVER=s3.
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="kpi-screenshots"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=15
MAX_IMAGES_PER_SNAPSHOT=30

# --- rate limits (per client, in-process) ----------------------------------
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_UPLOAD_PER_HOUR=60
RATE_LIMIT_AI_PER_HOUR=120
