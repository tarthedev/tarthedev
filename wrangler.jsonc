{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rollinson-stripe",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Stripe Tax needs a head office address in Dashboard > Settings > Tax before this can be "true".
    "AUTOMATIC_TAX": "false",
    // Days after the build invoice is paid before the first $129 care-plan charge.
    "CARE_PLAN_DELAY_DAYS": "30"
  }
  // Secrets (set with `wrangler secret put`): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ADMIN_TOKEN
}
