{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Same name as the Worker serving rollinsonnetwork.com today, so a deploy replaces it in place.
  "name": "rnet",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin/*", "/webhook"]
  },
  // Every lead is saved here before alerts go out, so none are lost if an alert fails.
  "kv_namespaces": [{ "binding": "LEADS", "id": "1345ac2cda9e4003bc61948dfaf92256" }],
  "routes": [
    { "pattern": "rollinsonnetwork.com", "custom_domain": true },
    { "pattern": "www.rollinsonnetwork.com", "custom_domain": true }
  ],
  "vars": {
    // Stripe Tax is active (head office: Elizabeth City, NC). It only charges tax where you add a
    // registration in Dashboard > Tax > Registrations; until then it tracks thresholds and charges $0.
    "AUTOMATIC_TAX": "true",
    // Days between paying $756 and the first $127 care-plan charge.
    "CARE_PLAN_DELAY_DAYS": "30",
    "ALERT_EMAIL": "aaron@rollinsonnetwork.com",
    "ALERT_FROM": "Rollinson Network Leads <leads@rollinsonnetwork.com>"
  }
  // Secrets (set with `npx wrangler secret put NAME`):
  //   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ADMIN_TOKEN, NTFY_TOPIC, RESEND_API_KEY
}
