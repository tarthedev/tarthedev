# Copy to .env and fill in. docs/SETUP.md walks through getting every value.
# Business details below already match rollinsonnetwork.com.

# ---------- server ----------
DOMAIN=voice.rollinsonnetwork.com
PUBLIC_BASE_URL=https://voice.rollinsonnetwork.com
# Any long random string. Generate one with: openssl rand -hex 32
APP_SECRET=
# Dashboard login at https://voice.rollinsonnetwork.com/admin
ADMIN_USER=aaron
ADMIN_PASSWORD=
TIMEZONE=America/New_York

# ---------- Claude (console.anthropic.com -> API keys) ----------
ANTHROPIC_API_KEY=
# Model for live calls. Effort "low" keeps replies fast on the phone.
VOICE_MODEL=claude-opus-5
VOICE_EFFORT=low
# Model for background work (preview-site copy, call summaries)
WORKER_MODEL=claude-opus-5

# ---------- Twilio (console.twilio.com) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The local number the AI sales rep calls from (E.164, e.g. +12525551234)
SALES_CALLER_ID=
# A second number prospects call to hear the receptionist answer as their business
DEMO_LINE_NUMBER=
# Texts go out from this number or Messaging Service SID (MG...). Blank = SALES_CALLER_ID.
SMS_FROM=
# ElevenLabs voices: voiceID-model-speed_stability_similarity. See docs/SETUP.md, "Pick the voices".
SALES_VOICE=UgBBYS2sOqTuMpoF3BR0-flash_v2_5-1.0_0.6_0.8
RECEPTIONIST_VOICE=NYC9WEgkq1u4jiqBseQ9-flash_v2_5-1.0_0.6_0.8
RECORD_SALES_CALLS=true

# ---------- the business ----------
BUSINESS_NAME=Rollinson Network
OWNER_NAME=Aaron Rollinson
OWNER_FIRST_NAME=Aaron
OWNER_PRONOUNS=they/them
# Where hot-lead alerts, transfers, and texts from prospects go
OWNER_CELL=+12522503044
OWNER_EMAIL=aaron@rollinsonnetwork.com
HOME_CITY=Elizabeth City
SERVICE_AREA=Elizabeth City and the Albemarle: Pasquotank, Camden, Currituck, and Perquimans counties
# The sales rep's name on calls
SALES_AGENT_NAME=Riley

# ---------- Stripe (dashboard.stripe.com -> Developers) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Fill these with: npm run cli -- stripe:setup   (or docker compose exec app node dist/cli.js stripe:setup)
STRIPE_PRICE_WEBSITE=
STRIPE_PRICE_WEBSITE_MONTHLY=
STRIPE_PRICE_RECEPTIONIST_SOLO=
STRIPE_PRICE_RECEPTIONIST_ADDON=

# ---------- Cal.com (app.cal.com -> Settings -> Developer -> API keys) ----------
CALCOM_API_KEY=
# The numeric ID of your 15-minute event type
CALCOM_EVENT_TYPE_ID=
# Your public booking page, e.g. https://cal.com/your-username/15min
CALCOM_BOOKING_URL=

# ---------- email (resend.com; the website form already uses Resend) ----------
RESEND_API_KEY=
EMAIL_FROM=Rollinson Network <ai@rollinsonnetwork.com>

# ---------- lead finding (console.cloud.google.com -> Places API (New)) ----------
GOOGLE_PLACES_API_KEY=

# ---------- dialer + compliance (docs/COMPLIANCE.md) ----------
# The AI only places calls on its own when this is true. You can still pause it from the dashboard.
DIALER_ENABLED=false
# Cold calls to business landlines: weekdays, these hours, in the lead's time zone
CALL_WINDOW_START=09:30
CALL_WINDOW_END=16:30
CALL_DAYS=1,2,3,4,5
# People who asked to be called from the website form
WEB_LEAD_WINDOW_START=08:00
WEB_LEAD_WINDOW_END=20:00
MAX_ATTEMPTS=3
RETRY_GAP_HOURS=48
DAILY_CALL_CAP=60
MAX_CONCURRENT_CALLS=1
# Line types the AI may cold-call without written consent. Don't add mobile.
AI_COLD_CALL_LINE_TYPES=landline,fixedVoip
# leave = drop a short voicemail at the beep; hangup = try again another day
VOICEMAIL_MODE=leave
ALLOW_LIVE_TRANSFER=true

# ---------- website form ----------
WEB_LEAD_ALLOWED_ORIGINS=https://rollinsonnetwork.com,https://www.rollinsonnetwork.com
