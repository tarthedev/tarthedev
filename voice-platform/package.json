{
  "name": "rollinson-voice",
  "version": "1.0.0",
  "description": "AI receptionist + AI sales rep platform for Rollinson Network",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/websocket": "^11.3.1",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.5",
    "stripe": "^22.6.2",
    "twilio": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
